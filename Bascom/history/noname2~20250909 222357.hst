$regfile = "avrx64da64.dat"                                                     ' the used chip
$crystal = 20000000                                                             ' frequency used
$hwstack = 40
$swstack = 40
$framesize = 40
declare sub Inthandler()
Dim X As Byte
Config Portc = Output                                                           ' make entire port output
Config Portb = Input                                                            ' make entire port input
Config Porta = Output                                                           ' make entire port output
Config Xpin = Portb , Pullup = Pullup , Sense = Falling
On Portb_int  Inthandler
enable Interrupts
Do
X = X  + 1
portc = x
If X = 0 Then Porta = 0                                                         ' when this loop overflows clear porta
Loop
End

Sub Inthandler()
   porta = &B1010_1010
END Sub