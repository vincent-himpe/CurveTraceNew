'------------------------------------------------------------------
'Micro: 64db64
'------------------------------------------------------------------
$regfile = "avrx64db64.dat"                                                     ' the used chip
$crystal = 20000000                                                             ' frequency used
$hwstack = 40
$swstack = 40
$framesize = 40


Dim LeftMarker as word
dim RightMarker as word
DECLARE SUB MarkerHandler()
declare sub KeyIntBhandler()


Declare sub KeyHandler()


dim cooked as word
dim cookedstring as string * 6

DIM X AS Integer
DIM Y AS INTEGER
DIM ADCRESULTS(3) AS INTEGER

DIM ADCSTRING AS STRING * 4
Dim ADCLength As Byte
Dim Xx As Byte
Dim ADCSpaces As Byte



$SIM

'----------------------------------------------
' CORE configuration
'----------------------------------------------

'Select oscillator and frequency
Config Osc = Enabled ', Frequency = 20mhz

' Configure TCA timer
config TCA0=normal, prescale=8, run=off, lupd=manual, compare0=disabled,compare1=disabled,compare2=disabled,cmp0_int = enabled,cmp1_int=enabled    '

  ' interrupt control register : 0011_0000  : cmp1 and cmp0 enabled, overflow interrupt off
  ' interrupt control register : x210xxxO  : compare2, compare1,compare0, overflow
  ' ctrlb register : x210_AMMM : cmp2en,cmp1en,cmp0en,alupd, mode(3) : normal mode = 000
  ' evctrl register : 0000_0eec : ee = event action , c = cntei : should be 0
  ' ctrla register : xxxx_ccce  : ccc = prescaler , e = enable


'----------------------------------------------
' ADC configuration. Manual becasue BASCOM can't do some options i need.
'----------------------------------------------
ADC0_CTRLA    = &B1000_0001   ' Enable adc in standby , 10 bit, not freerunning, master enable
ADC0_CTRLB    = &b0000_0000   ' sample count. leave at zero, may up that depending on time
adc0_ctrlc    = &B0110_0000   ' reduced sample cap, external vref , prescaler , set to zero.
adc0_ctrld    = &B0100_0100   ' delay 32 cycles after channel switching , no randomisation, 4 clockcycles delay between samples
ADC0_CTRLE    = &B0000_0000   ' no window comparator
ADC0_SAMPCTRL = &B0000_0000   ' zero sample length. we have our own s/h system
ADC0_MUXPOS   = 0             ' channel selection , we use only lowest 2 bits.
ADC0_COMMAND  = 0             ' set to 1 to start conversion. will fall to zero when conversion is done
ADC0_EVCTRL   = &b0000_0000   ' no event trigger
ADC0_INTCTRL  = &b0000_0000   ' no window comparator interrupt , no result ready interrupt
'    ADC0_INTFLAGS                 ' don't care we don't use interrupts
ADC0_DBGCTRL  = &b0000_0001   ' keep running in debug
ADC0_WINLT    = 0             ' we don't use window low threshold
ADC0_WINHT    = 0             ' we don't use window high threshold

'BASCOM SET UP ADC
'CONFIG ADC0 = SINGLE, RUNMODE=ENABLED, RESOLUTION = 10BIT,ADC=ENABLED,SAMPLE_ACCU=0,SAMPLE_CAP=ABOVE_1V,REFERENCE=INTERNAL
'CONFIG VREF=DUMMY, ADC0= 2V5

'----------------------------------------------
' I/O port configuration
'----------------------------------------------

' DAC control port
'----------------------------------------------
config PORTC = output
config xpin = portc, pullup = pullup

' Input bank
'----------------------------------------------
' bank layout :
' PB0 : KEYINTB
' PB1 : KEYINTA
' PB2 : Sweepstart
' PB3 : ROTKEY
' PB4 : ROTPHA
' PB5 : ROTPHB

config PORTB = input
config xpin = PORTB, pullup = pullup , sense = falling
' config xpin = portb.0 , sense = falling

PORTB_PIN0CTRL = &b0_000_1_011   ' no inversion,  000 , pullup on , falling edge interrupt
PORTB_PIN1CTRL = &b0_000_1_011   ' no inversion,  000 , pullup on , falling edge interrupt
PORTB_PIN2CTRL = &b0_000_1_011   ' no inversion,  000 , pullup on , falling edge interrupt
PORTB_PIN3CTRL = &b0_000_1_011   ' no inversion,  000 , pullup on , falling edge interrupt
PORTB_PIN4CTRL = &b0_000_1_011   ' no inversion,  000 , pullup on , falling edge interrupt
PORTB_PIN0CTRL = &b0_000_1_000   ' no inversion,  000 , pullup on , no interrupt



' KEYINTA ALIAS PORTB.0
' KEYINTB ALIAS PORTB.1
' SWEEPSTART ALIAS PORTB.2
' ROTKEY ALIAS PORTB.3
' ROTPHA ALIAS PORTB.4
' ROTPHB ALIAS PORTB.5

' Output Bank
'----------------------------------------------
' bank layout :
' PE0 : KEEPON
' PE1 : MARKER
' PE2 : MARKERENABLE
config PORTE = output
config xpin = porte, pullup=pullup

' SET UP LCD
'----------------------------------------------
' PortF is used for the LCD
' future : see if we can use the lcd4 library...

CONFIG LCDPIN = PIN, DB4 = PORTF.0, DB5 = PORTF.1 , DB6 = PORTF.2, DB7 = PORTF.3, E= PORTF.4 , RS = PORTF.6
'config LCD = 40x2
'CURSOR OFF NOBLINK
'CLS
'HOME UPPER


'----------------------------------------------
'SET UP INTERRUPTS
'----------------------------------------------

' TIMER interrupts :

'ON TCA0_CMP0 MarkerHandler nosave  ' compare0 handler
'ON TCA0_CMP1 MarkerHandler nosave  ' compare1 handler (the same)

on portb_int  KeyIntBhandler
'enable PORTB_INT
enable Interrupts




'ON  ADC0_RDY ADCREAD() NOSAVE

'----------------------------------------------
' STARTUP
'----------------------------------------------

config LCD = 40x2
CURSOR OFF NOBLINK
CLS
HOME UPPER
LCD "CT9084 Curve Tracer"
LOWERLINE
LCD "V0.0 -ALPHA- . Initializing"




Do
 '  PORTc_OUT = &b1010_1010
   Y = GETADC(0)
   cooked = 0
   cooked = y
   cooked = cooked * 4
   LOCATE 1,30
   LCD format(cookedstring," 0.00")
   LOCATE 2,30
  'cooked = cooked \10
   cookedstring = str(cooked)
   LCD format(cookedstring,"0.000")


   Waitms 1
'   PORTc_OUT = &b0101_0101
   'incr portc
   X = X + 1
Loop
END


SUB MarkerHandler()
   porta.1 = 1
   !NOP
   !NOP
   !NOP
   !NOP
   !NOP
   !NOP
   porta.2 = 1
   !NOP
   !NOP
   !NOP
   !NOP
   !NOP
   !NOP
   porta.1=0
   porta.2=0
end sub

sub KeyHandler()
end sub

Sub KeyIntBhandler()
    'locate 1,1
    'lcd"BLAH"
    Portc = &B1010_1010
    return
end sub